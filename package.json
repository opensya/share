{
  "name": "@opensya/share",
  "version": "0.29.1-alpha.0",
  "repository": "opensya/share",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "private": false,
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    },
    "./set-globals": {
      "types": "./dist/set-globals.d.ts",
      "import": "./dist/set-globals.mjs",
      "require": "./dist/set-globals.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "publish:local": "tsx scripts/publish-local.ts",
    "build": "rslib",
    "dev": "tsx rslib --watch",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "opensya",
    "share",
    "@opensya/share"
  ],
  "license": "ISC",
  "packageManager": "pnpm@10.32.1",
  "devDependencies": {
    "@babel/core": "^7.29.0",
    "@rslib/core": "^0.21.3",
    "@types/fs-extra": "^11.0.4",
    "@types/lodash": "^4.17.24",
    "@types/node": "^25.6.0",
    "@types/prompts": "^2.4.9",
    "consola": "^3.4.2",
    "prompts": "^2.4.2",
    "tsx": "^4.21.0"
  },
  "dependencies": {
    "lodash": "^4.18.1",
    "mongoose": "^9.4.1",
    "ofetch": "^1.5.1",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.2",
    "zod": "^4.3.6"
  }
}
