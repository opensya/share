{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "outDir": "./dist",
    "rootDir": ".",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "emitDeclarationOnly": false,
    "skipLibCheck": true,
    "paths": {
      "@share": [
        "./src"
      ],
      "@share/*": [
        "./src/*"
      ],
    },
    "lib": [
      "ESNext",
      "DOM"
    ],
    "types": [
      "node"
    ]
  },
  "include": [
    "./src/**/*.ts",
    "./rslib.config.ts"
  ],
  "exclude": [
    "dist",
    "node_modules",
  ]
}