{
  "compilerOptions": {
    "module": "nodenext",
    "target": "ES2023",

    "declaration": true,
    "emitDeclarationOnly": true,

    "outDir": "dist",
    "rootDir": "src",

    "strict": true,
    "skipLibCheck": true,
    "typeRoots": ["./types"],
    "paths": {
      "@share": ["./src"],
      "@share/*": ["./src/*"],
    }
  },
  "include": ["src"],
}